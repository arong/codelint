#!/bin/bash
set -euo pipefail

# ========================================
# Commit Message Format Validation
# ========================================
# Format: <type>: <description>
# Types: feat, fix, refactor, docs, test, chore, style, perf, build, ci

COMMIT_MSG_FILE=$1
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

echo "Validating commit message..."

# Valid commit types
VALID_TYPES="feat|fix|refactor|docs|test|chore|style|perf|build|ci|release"

# Check format: type: description (or type(scope): description)
if ! echo "$COMMIT_MSG" | grep -qE "^(${VALID_TYPES})(\(.+\))?: .+"; then
    echo "Invalid commit message format!"
    echo ""
    echo "Expected format:"
    echo "  <type>: <description>"
    echo "  <type>(scope): <description>"
    echo ""
    echo "Valid types: feat, fix, refactor, docs, test, chore, style, perf, build, ci, release"
    echo ""
    echo "Examples:"
    echo "  feat: add new initialization check"
    echo "  fix: resolve memory leak in plugin"
    echo "  refactor(core): simplify init logic"
    echo "  docs: update README with examples"
    echo ""
    echo "Your message:"
    echo "  $COMMIT_MSG"
    exit 1
fi

echo "Commit message format valid"

# ========================================
# AI Branch Restriction Check
# ========================================
# Feature work must use feature/* or fix/* branches
# Blocked branches: main, master, production, release

CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)

BLOCKED_BRANCHES="main|master|production|release"

if echo "$CURRENT_BRANCH" | grep -qE "^(${BLOCKED_BRANCHES})$"; then
    echo ""
    echo "BLOCKED: cannot commit to production branches"
    echo ""
    echo "Current branch: $CURRENT_BRANCH"
    echo ""
    echo "Development workflow:"
    echo "  Local:  git worktree add ../codelint-<name> -b feature/<name> origin/main"
    echo "  Cloud:  git switch -c feature/<name>"
    echo "  Then:   commit/push and open PR → main"
    echo ""
    exit 1
fi

echo "Branch check passed (branch: $CURRENT_BRANCH)"
