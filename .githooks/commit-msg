#!/bin/bash
set -euo pipefail

# ========================================
# Commit Message Format Validation
# ========================================
# Format: <type>: <description>
# Types: feat, fix, refactor, docs, test, chore, style, perf, build, ci

COMMIT_MSG_FILE=$1
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

echo "🔍 Validating commit message..."

# Valid commit types
VALID_TYPES="feat|fix|refactor|docs|test|chore|style|perf|build|ci|release"

# Check format: type: description (or type(scope): description)
if ! echo "$COMMIT_MSG" | grep -qE "^(${VALID_TYPES})(\(.+\))?: .+"; then
    echo "❌ Invalid commit message format!"
    echo ""
    echo "Expected format:"
    echo "  <type>: <description>"
    echo "  <type>(scope): <description>"
    echo ""
    echo "Valid types: feat, fix, refactor, docs, test, chore, style, perf, build, ci, release"
    echo ""
    echo "Examples:"
    echo "  feat: add new initialization check"
    echo "  fix: resolve memory leak in plugin"
    echo "  refactor(core): simplify init logic"
    echo "  docs: update README with examples"
    echo ""
    echo "Your message:"
    echo "  $COMMIT_MSG"
    exit 1
fi

echo "✅ Commit message format valid"

# ========================================
# AI Branch Restriction Check
# ========================================
# AI can commit on feature/*, bugfix/*, refactor/* branches
# Blocked branches: main, master, production

CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)

BLOCKED_BRANCHES="main|master|production"
ALLOWED_PATTERNS="feature/.*|bugfix/.*|refactor/.*"

if echo "$CURRENT_BRANCH" | grep -qE "^(${BLOCKED_BRANCHES})$"; then
    echo ""
    echo "╔══════════════════════════════════════╗"
    echo "║  🚫 BLOCKED: AI cannot commit to     ║"
    echo "║  main branch                         ║"
    echo "╚══════════════════════════════════════╝"
    echo ""
    echo "Current branch: $CURRENT_BRANCH"
    echo ""
    echo "AI development workflow:"
    echo "  1. Create feature/bugfix branch from main"
    echo "     git checkout main && git pull"
    echo "     git checkout -b feature/<feature-name>"
    echo "  2. Work on the feature branch (allowed)"
    echo "  3. Push and create PR to main"
    echo "     gh pr create --base main --head feature/<name>"
    echo ""
    echo "Allowed branch patterns:"
    echo "  - feature/*  (one feature per branch)"
    echo "  - bugfix/*   (bug fixes)"
    echo "  - refactor/* (refactoring work)"
    echo ""
    echo "If you need to bypass this restriction:"
    echo "  git commit --no-verify -m 'emergency fix'"
    echo ""
    exit 1
fi

# ========================================
# Success Checks
# ========================================
echo "✅ Branch check passed (branch: $CURRENT_BRANCH)"

# Run tests if on feature/bugfix/refactor branches
if echo "$CURRENT_BRANCH" | grep -qE "^(${ALLOWED_PATTERNS})$"; then
    echo "🧪 Running quick tests..."
    
    # Check if build directory exists
    if [ -d "build" ]; then
        # Run unit tests only (quick validation)
        if cmake --build build --target test-unit 2>/dev/null; then
            echo "✅ Unit tests passed"
        else
            echo "⚠️  Warning: Unit tests failed or not available"
            echo "   Continuing commit (full tests run in CI)"
        fi
    else
        echo "⚠️  Build directory not found, skipping tests"
    fi
    
    echo "✓ All checks passed. Commit proceeding."
fi