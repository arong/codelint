#!/bin/bash
set -euo pipefail

CLANG_FORMAT="/opt/homebrew/opt/llvm@21/bin/clang-format"

echo "🔍 Running pre-commit checks..."

# ========================================
# Check 1: clang-format ALL C++ files (not just staged)
# ========================================
echo "📝 Formatting all C++ files with clang-format..."

# Find ALL C++ files in the repo (not just staged)
ALL_CPP_FILES=$(find . -type f \( \
    -name '*.cpp' -o \
    -name '*.cc' -o \
    -name '*.cxx' -o \
    -name '*.h' -o \
    -name '*.hpp' -o \
    -name '*.hh' -o \
    -name '*.hxx' \
    \) ! -path './.git/*' ! -path './build/*' ! -path './.sisyphus/*' 2>/dev/null || true)

if [[ -n "$ALL_CPP_FILES" ]]; then
    if [[ ! -x "$CLANG_FORMAT" ]]; then
        echo "⚠️  Warning: clang-format not found at $CLANG_FORMAT"
        echo "   Install LLVM or update CLANG_FORMAT path in .githooks/pre-commit"
    else
        FORMATTED_COUNT=0
        echo "$ALL_CPP_FILES" | while read -r file; do
            if [[ -f "$file" ]]; then
                # Check if file needs formatting by comparing with formatted output
                if ! "$CLANG_FORMAT" --dry-run --Werror "$file" 2>/dev/null > /dev/null; then
                    "$CLANG_FORMAT" -i "$file"
                    git add "$file"
                    echo "   formatted: $file"
                    FORMATTED_COUNT=$((FORMATTED_COUNT + 1))
                fi
            fi
        done
        echo "✅ C++ formatting complete"
    fi
else
    echo "   No C++ files found"
fi

# ========================================
# Check 2: Trailing whitespace - AUTO-FIX on ALL files
# ========================================
echo "📝 Checking and fixing trailing whitespace on all files..."

# Find and fix all files with trailing whitespace - checks ALL files, not just staged
FILES_WITH_WHITESPACE=$(grep -r '[[:blank:]]$' \
    --include='*.cpp' \
    --include='*.h' \
    --include='*.txt' \
    --include='*.md' \
    --include='*.sh' \
    --include='*.py' \
    --include='*.yml' \
    --include='*.yaml' \
    --include='*.json' \
    --include='*.cmake' \
    -l . 2>/dev/null | grep -v -E '(\.git/|build/|\.sisyphus/)' || true)

if [[ -n "$FILES_WITH_WHITESPACE" ]]; then
    echo "   Found trailing whitespace in:"
    echo "$FILES_WITH_WHITESPACE" | sed 's/^/     - /'
    echo "   Auto-fixing..."
    
    # Remove trailing whitespace from each file
    echo "$FILES_WITH_WHITESPACE" | while read -r file; do
        if [[ -f "$file" ]]; then
            # Use sed to remove trailing whitespace (macOS compatible with -i '')
            sed -i '' 's/[[:space:]]*$//' "$file"
            git add "$file"
            echo "   ✓ fixed: $file"
        fi
    done
    echo "✅ Trailing whitespace auto-fixed"
else
    echo "✅ No trailing whitespace found"
fi

# ========================================
# Check 3: Missing trailing newline
# ========================================
echo "📝 Checking trailing newlines..."

errors=0
while IFS= read -r -d '' file; do
    last=$(tail -c 1 "$file" 2>/dev/null | od -An -tx1 | tr -d ' \n')
    if [ "$last" != "0a" ] && [ -s "$file" ]; then
        echo "❌ Missing trailing newline: $file"
        errors=$((errors + 1))
    fi
done < <(find . -type f \( -name '*.cpp' -o -name '*.h' -o -name '*.txt' -o -name '*.md' -o -name '*.sh' -o -name '*.py' \) ! -path './.git/*' ! -path './build/*' ! -path './.sisyphus/*' -print0)

if [ $errors -ne 0 ]; then
    echo "❌ Error: $errors file(s) missing trailing newline"
    exit 1
fi
echo "✅ All files have trailing newlines"

echo "✨ All pre-commit checks passed!"
