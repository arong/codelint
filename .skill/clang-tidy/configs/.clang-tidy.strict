---
# clang-tidy strict configuration
# Production-level checks including CERT and C++ Core Guidelines
# Higher noise but catches more potential issues

Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-implicit-widening-of-multiplication-result,
  cert-*,
  -cert-dcl21-c,
  -cert-dcl50-cpp,
  -cert-env33-c,
  -cert-err34-c,
  -cert-err52-cpp,
  -cert-err58-cpp,
  -cert-err60-cpp,
  -cert-flp30-c,
  -cert-msc50-cpp,
  -cert-msc51-cpp,
  -cert-oop57-cpp,
  cppcoreguidelines-*,
  -cppcoreguidelines-avoid-c-arrays,
  -cppcoreguidelines-avoid-do-while,
  -cppcoreguidelines-avoid-goto,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-avoid-non-const-global-variables,
  -cppcoreguidelines-c-copying-signature,
  -cppcoreguidelines-explicit-virtual-functions,
  -cppcoreguidelines-interfaces-global-init,
  -cppcoreguidelines-macro-usage,
  -cppcoreguidelines-narrowing-conversions,
  -cppcoreguidelines-no-malloc,
  -cppcoreguidelines-owning-memory,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  -cppcoreguidelines-pro-bounds-constant-array-index,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-pro-type-cstyle-cast,
  -cppcoreguidelines-pro-type-member-init,
  -cppcoreguidelines-pro-type-reinterpret-cast,
  -cppcoreguidelines-pro-type-static-cast-downcast,
  -cppcoreguidelines-pro-type-union-access,
  -cppcoreguidelines-pro-type-vararg,
  -cppcoreguidelines-slicing,
  -cppcoreguidelines-special-member-functions,
  -cppcoreguidelines-virtual-class-destructor,
  modernize-*,
  -modernize-use-trailing-return-type,
  -modernize-use-nodiscard,
  -modernize-concat-nested-namespaces,
  -modernize-macro-to-enum,
  performance-*,
  readability-*,
  -readability-function-cognitive-complexity,
  -readability-identifier-length,
  -readability-inconsistent-declaration-parameter-name,
  -readability-isolate-declaration,
  -readability-magic-numbers,
  -readability-named-parameter,
  -readability-redundant-access-specifiers,
  -readability-simplify-boolean-expr,
  -readability-uppercase-literal-suffix,
  clang-analyzer-*,
  -clang-analyzer-alpha.*

HeaderFilterRegex: '.*'
WarningsAsErrors: >
  bugprone-argument-comment,
  bugprone-dangling-handle,
  bugprone-string-constructor,
  bugprone-suspicious-memset-usage,
  bugprone-suspicious-realloc-usage,
  bugprone-use-after-move,
  cert-dcl03-c,
  cert-dcl16-c,
  cert-dcl37-c,
  cert-dcl51-cpp,
  cert-dcl54-cpp,
  cert-dcl59-cpp,
  cert-err09-cpp,
  cert-err61-cpp,
  cert-fio38-c,
  cert-str34-c,
  cppcoreguidelines-avoid-capturing-lambda-coroutines,
  cppcoreguidelines-avoid-reference-coroutine-parameters,
  modernize-use-nullptr,
  modernize-use-override

FormatStyle: 'file'
InheritParentConfig: true

CheckOptions:
  # modernize-use-auto
  - key: modernize-use-auto.MinTypeNameLength
    value: '5'
  
  # cert-dcl16-c: unsigned suffixes
  - key: cert-dcl16-c.NewSuffixes
    value: 'L;LL;LU;LLU'
  
  # readability-function-cognitive-complexity (lower threshold)
  - key: readability-function-cognitive-complexity.Threshold
    value: '25'
  
  # performance-move-const-arg
  - key: performance-move-const-arg.CheckTriviallyCopyableMove
    value: '1'