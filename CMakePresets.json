{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "macos-base",
      "hidden": true,
      "displayName": "macOS Base",
      "description": "Base configuration for macOS",
      "cacheVariables": {
        "CMAKE_OSX_SYSROOT": {
          "type": "STRING",
          "value": "$env{SDKROOT}"
        },
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "macos-llvm21",
      "displayName": "macOS (LLVM 21)",
      "description": "Build for macOS with LLVM 21",
      "inherits": "macos-base",
      "cacheVariables": {
        "LLVM_DIR": {
          "type": "PATH",
          "value": "/opt/homebrew/opt/llvm@21/lib/cmake/llvm"
        }
      },
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "displayName": "Linux Base",
      "description": "Base configuration for Linux",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "linux-llvm15",
      "displayName": "Linux (LLVM 15)",
      "description": "Build for Linux with LLVM 15",
      "inherits": "linux-base",
      "cacheVariables": {
        "LLVM_DIR": {
          "type": "PATH",
          "value": "/usr/lib/llvm-15/lib/cmake/llvm"
        }
      },
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-llvm21",
      "displayName": "Linux (LLVM 21)",
      "description": "Build for Linux with LLVM 21",
      "inherits": "linux-base",
      "cacheVariables": {
        "LLVM_DIR": {
          "type": "PATH",
          "value": "/usr/lib/llvm-21/lib/cmake/llvm"
        }
      },
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "default",
      "displayName": "Default",
      "description": "Default build (auto-detect platform and LLVM version)",
      "inherits": [
        "macos-llvm21",
        "linux-llvm21"
      ],
      "binaryDir": "${sourceDir}/build"
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "displayName": "Default Build",
      "configurePreset": "default"
    }
  ]
}
